# =============================================================================
# « Mon Livre Magique » — variables d'environnement
# Copiez ce fichier en .env puis renseignez chaque valeur.
# AUCUNE clé ne doit être committée. Toutes les clés restent côté serveur.
# =============================================================================

# --- Base de données PostgreSQL (Supabase, Neon, ou autre) --------------------
# Chaîne de connexion complète utilisée par Prisma.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/mon_livre_magique?schema=public"

# --- Auth.js / NextAuth -------------------------------------------------------
# URL publique de l'application (sans slash final en production).
AUTH_URL="http://localhost:3000"
# Secret de chiffrement des sessions. Générez-le avec : openssl rand -base64 32
AUTH_SECRET="a_remplacer_par_un_secret_aleatoire_long"

# --- Envoi des liens magiques par email (connexion sans mot de passe) ---------
# Serveur SMTP utilisé pour envoyer le lien de connexion.
EMAIL_SERVER_HOST="smtp.exemple.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="utilisateur_smtp"
EMAIL_SERVER_PASSWORD="motdepasse_smtp"
# Adresse d'expédition affichée dans les emails.
EMAIL_FROM="Mon Livre Magique <bonjour@exemple.com>"

# --- Génération de texte : API Anthropic (Claude) -----------------------------
# Clé API Anthropic. Uniquement côté serveur, jamais exposée au navigateur.
ANTHROPIC_API_KEY="sk-ant-a-remplacer"
# Modèle Claude utilisé pour générer les histoires.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Voix (lecture à voix haute) ---------------------------------------------
# Par défaut la synthèse vocale du navigateur (Web Speech API) est utilisée.
# Valeurs possibles : "browser" (défaut) ou "elevenlabs".
VOICE_PROVIDER="browser"
# Clé ElevenLabs, requise uniquement si VOICE_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=""

# --- Illustrations (version ultérieure) --------------------------------------
# Fournisseur d'images. "none" désactive toute génération d'image (défaut).
IMAGE_PROVIDER="none"

# --- Paiement : Stripe (mode test puis production) ---------------------------
# Clé secrète Stripe (côté serveur uniquement).
STRIPE_SECRET_KEY="sk_test_a_remplacer"
# Secret de signature du webhook Stripe (fourni par Stripe CLI ou le dashboard).
STRIPE_WEBHOOK_SECRET="whsec_a_remplacer"
# Prix d'un livre, en centimes (ex : 499 = 4,99 €).
BOOK_PRICE_CENTS="499"
# Devise ISO (ex : eur).
BOOK_CURRENCY="eur"

# --- Limites de coût ----------------------------------------------------------
# Nombre maximum de livres qu'un utilisateur peut créer par jour.
MAX_BOOKS_PER_DAY="5"

# --- Version des CGU acceptées (utilisée pour le consentement parental) -------
TERMS_VERSION="2026-01-01"
